diff --git a/bol/doctor.py b/bol/doctor.py
--- a/bol/doctor.py
+++ b/bol/doctor.py
@@ -69,6 +69,19 @@
     return _acknowledge_gpu_crash()
 
 
+def _qr_rendering_ready():
+    """Check the complete local QR rendering path used by the sign-in UI."""
+    try:
+        from .qrcodegen import QrCode
+        from PIL import Image
+        qr = QrCode.encode_text(
+            "https://www.microsoft.com/link", QrCode.Ecc.LOW)
+        image = Image.new("1", (qr.get_size() + 4, qr.get_size() + 4), 1)
+        return image.size[0] > 21
+    except Exception:
+        return False
+
+
 def doctor(acknowledge_gpu_crash=False):
     if acknowledge_gpu_crash and not _acknowledge_gpu_crash():
         return False
@@ -92,5 +105,12 @@
     print(f"  {'customtkinter':12} : "
           f"{'OK (GUI)' if ctk_ok else 'auto-installed on launch'}")
+    qr_ok = _qr_rendering_ready()
+    print(f"  {'pillow/QR':12} : "
+          f"{'OK (GUI)' if qr_ok else 'MANQUANT (GUI)'}")
+    if not qr_ok:
+        warn("Pillow/QR rendering is unavailable in this launcher environment. "
+             "On NixOS, activate the current BedrockOnLinux package before "
+             "retrying the sign-in dialog.")
     cr_ok = deps.have("cryptography")
     print(f"  {'cryptography':12} : "
