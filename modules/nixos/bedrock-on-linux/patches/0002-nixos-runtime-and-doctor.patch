diff --git a/bol/prefix.py b/bol/prefix.py
--- a/bol/prefix.py
+++ b/bol/prefix.py
@@ -847,6 +847,12 @@
 def headless_setup_env(env, native_cryptbase=False):
     """Prevent non-graphical Wine setup helpers from initialising a GPU."""
     result = dict(env)
+    # UMU promotes inherited LD_LIBRARY_PATH into STEAM_RUNTIME_LIBRARY_PATH.
+    # The prefix bootstrap is deliberately headless and must not feed the
+    # desktop's development libraries into pressure-vessel's libc boundary.
+    # Keep the normal graphics environment intact for the actual game launch.
+    result.pop("LD_LIBRARY_PATH", None)
+    result.pop("STEAM_RUNTIME_LIBRARY_PATH", None)
     result.pop("DISPLAY", None)
     result.pop("WAYLAND_DISPLAY", None)
     result.pop("XAUTHORITY", None)
