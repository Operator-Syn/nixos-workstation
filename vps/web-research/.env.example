# Public template only. Replace every REPLACE_WITH_* value in the encrypted
# node-local environment; never commit a real dotenv file or credential.
FIRECRAWL_POSTGRES_USER=firecrawl
FIRECRAWL_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
FIRECRAWL_POSTGRES_DB=firecrawl
FIRECRAWL_API_KEY=REPLACE_WITH_FIRECRAWL_API_KEY
SEARXNG_SECRET=REPLACE_WITH_RANDOM_SECRET

# Structured extraction stays disabled until these are intentionally set.
# OpenAI-compatible provider:
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_NAME=
MODEL_EMBEDDING_NAME=
# Local compatible provider alternative:
OLLAMA_BASE_URL=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
MAX_CPU=0.75
MAX_RAM=0.75
SCRAPE_MAX_ATTEMPTS=3

NUM_WORKERS_PER_QUEUE=2
CRAWL_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_JOBS=2
BROWSER_POOL_SIZE=2
SEARXNG_ENGINES=arxiv,crossref,openalex,semantic-scholar,pubmed,github,bing,brave,duckduckgo
SEARXNG_CATEGORIES=general
FIRECRAWL_RETRY_MAX_ATTEMPTS=2
FIRECRAWL_RETRY_INITIAL_DELAY=1000
FIRECRAWL_RETRY_MAX_DELAY=5000
